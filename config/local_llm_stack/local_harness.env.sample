# Copy to local_harness.env for machine-local overrides. Do not commit secrets.
LOCAL_QWEN_MODEL=qwen-local
LOCAL_QWEN_BASE=http://127.0.0.1:1234
LOCAL_QWEN_CODEX_CONTEXT_WINDOW=32768
LOCAL_QWEN_CODEX_AUTO_COMPACT_LIMIT=28672
LOCAL_QWEN_GUARD_PROFILE=balanced
CODEX_TEXTGEN_MAX_OUTPUT_TOKENS=6144
CODEX_TEXTGEN_TOOL_TEMPERATURE=0.15
# Qwen3.8 supports native low/medium/xhigh template modes. The bridge maps
# generic client tiers into these bounded local reasoning budgets and reserves
# final-answer tokens so thought does not consume the response.
CODEX_TEXTGEN_REASONING_DEFAULT_EFFORT=medium
CODEX_TEXTGEN_REASONING_BUDGET_LOW=1536
CODEX_TEXTGEN_REASONING_BUDGET_MEDIUM=3072
CODEX_TEXTGEN_REASONING_BUDGET_XHIGH=5120
CODEX_TEXTGEN_REASONING_OUTPUT_RESERVE_TOKENS=1024
# Tool protocols are mutually exclusive: false uses the compact bridge XML
# convention; true forwards only native OpenAI-style function definitions.
CODEX_TEXTGEN_NATIVE_TOOLS=false
# Optional: set an explicit reviewed prompt file. The bridge has no hidden
# machine-local prompt dependency when this is unset.
# CODEX_TEXTGEN_SYSTEM_PROMPT_FILE=/path/to/reviewed-system-prompt.txt
